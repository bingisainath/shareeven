# backend/.env.example: copy to backend/.env and fill in. Never commit .env.
# Anything left out uses the default in app/config/settings.py.

# ---------------------------------------------------------------- general
# local, staging or production. In production, emails that can't be sent are errors (not logged)
ENV=local
DEBUG=false
# DEBUG shows every WebSocket event and worker step
LOG_LEVEL=INFO
# Used in password-reset links: the web app's address
FRONTEND_URL=http://localhost:3000

# ---------------------------------------------------------------- database and Redis
# Local: Postgres and Redis from infra/docker (docker compose up -d)
DATABASE_URL=postgresql+asyncpg://papyris:papyris@localhost:5432/papyris
REDIS_URL=redis://localhost:6379/0
redis_dsn=redis://localhost:6379/0

# ---------------------------------------------------------------- secrets (keep these forever)
# Generate each with:
#   python -c "import secrets,base64;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# Signs sign-in tokens and media links. Changing it signs everyone out.
JWT_SECRET_KEY=
# Encrypts uploaded photos, videos and files on disk. Losing or changing it makes every upload
# unreadable. Empty = derived from JWT_SECRET_KEY (then never change that either).
MEDIA_ENCRYPTION_KEY=
# Encrypted the AI keys people used to add themselves (that option is gone). Keep it if your
# database has old rows; a new install can leave it empty.
AI_KEY_ENCRYPTION_SECRET=

# ---------------------------------------------------------------- receipt scanning
# The app's Claude key (console.anthropic.com > API keys). Every scan uses it; app admins choose
# the model and the monthly limit in the admin console.
ANTHROPIC_API_KEY=
# Only if the key isn't tied to a workspace (Console > Settings > Workspaces)
# ANTHROPIC_WORKSPACE_ID=
# Only if an OpenAI model is offered in the admin console
# OPENAI_API_KEY=
# low | medium | high: how long the model thinks. Medium read every test receipt right (2026-10)
# RECEIPT_AI_EFFORT=medium
# RECEIPT_SCANS_PER_MONTH=100
# Cheap path: OCR on this server's CPU, then this text model; photos go to the admins' model only
# when the OCR read doesn't add up. Empty = always send the photos.
# RECEIPT_OCR_MODEL=claude-sonnet-5
# RECEIPT_OCR_EFFORT=none
# RECEIPT_OCR_MAX_TOKENS=8000
# RECEIPT_OCR_MIN_CONFIDENCE=0.95
# An unclear photo asks the person for a new one instead of going to the photo model (false = photo model)
# RECEIPT_OCR_RETAKE_UNCLEAR=true
# RECEIPT_OCR_THREADS=4
# Remote OCR: machines running scripts/ocr_agent.py (e.g. a laptop) read the photos instead of this
# server. On when the token is set (32+ random characters). See infra/ocr-agent/README.md
# RECEIPT_OCR_AGENT_TOKEN=
# RECEIPT_OCR_AGENT_TIMEOUT_SECONDS=60
# No agent online or no answer in time: photos = the admins' model reads the photos, local = OCR here
# RECEIPT_OCR_WHEN_AGENT_OFFLINE=photos
# Temporary, for testing by hand: each scan's OCR text and model outputs (plain text). Keep off on a server
# RECEIPT_OCR_DEBUG_DIR=ocr_debug

# ---------------------------------------------------------------- email
# Leave SMTP_USER and SMTP_PASSWORD empty locally: emails (sign-up codes, reset links) are
# written to the API log instead of being sent.
# Production, with Resend (shareeven.com verified there, DNS in Cloudflare):
#   SMTP_HOST=smtp.resend.com
#   SMTP_PORT=465
#   SMTP_USER=resend
#   SMTP_PASSWORD=re_...   (a Resend API key with "Sending access" to shareeven.com only)
#   FROM_EMAIL=noreply@shareeven.com
#   REPLY_TO=support@shareeven.com   (Cloudflare Email Routing forwards it to the team inbox)
SMTP_USER=
SMTP_PASSWORD=

# ---------------------------------------------------------------- push notifications
# Firebase console > Project settings > Service accounts > Generate new private key.
# Keep the JSON outside the repo. Empty = no push notifications.
FIREBASE_SERVICE_ACCOUNT_FILE=
# false = notifications only say "New message" (no preview)
# PUSH_SHOW_MESSAGE_TEXT=true

# ---------------------------------------------------------------- optional
# Limits on logins, sign-ups, uploads and messages (counted in Redis)
# RATE_LIMITS_ENABLED=true
# Give each message worker a different name when running several on one machine
# WORKER_NAME=

# ShareEven Pro payments (Razorpay dashboard → Account & Settings). Use rzp_test_ keys locally;
# production refuses to start with test keys or without all three.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
